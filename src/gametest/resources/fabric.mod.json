{
  "schemaVersion": 1,
  "id": "prime_ants_test",
  "version": "1.0.0",
  "name": "Prime Ants development tests",
  "environment": "*",
  "mixins": [
    "prime_ants_test.mixins.json",
    {
      "config": "prime_ants_test.client.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "main": ["dev.primeants.gametest.RestartHarness"],
    "fabric-gametest": [
      "dev.primeants.gametest.BootstrapGameTest",
      "dev.primeants.gametest.AntEntityGameTest",
      "dev.primeants.gametest.QueenFoundingGameTest",
      "dev.primeants.gametest.BroodGameTest",
      "dev.primeants.gametest.WorkerForagingGameTest",
      "dev.primeants.gametest.TransferGameTest"
    ],
    "fabric-client-gametest": [
      "dev.primeants.gametest.AntModelGameTest",
      "dev.primeants.gametest.AntCaptureTest"
    ]
  },
  "depends": {
    "prime_ants": "*",
    "fabric-api": "*"
  }
}
